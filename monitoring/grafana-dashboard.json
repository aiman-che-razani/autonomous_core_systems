{
  "title": "GreyQueue operations",
  "uid": "greyqueue",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greyqueue_queue_depth"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Completed jobs per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(greyqueue_jobs_completed_total[5m])"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Retries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(greyqueue_jobs_retried_total[5m])"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Worker utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greyqueue_worker_utilization"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Heartbeat age",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greyqueue_worker_heartbeat_age_seconds"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Execution P95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greyqueue_job_duration_seconds{statistic=\"p95\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Workers by state",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greyqueue_workers",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Failed jobs per second",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(greyqueue_jobs_failed_total[5m])",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Admission saturation",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greyqueue_queue_saturation_ratio",
          "legendFormat": "saturation"
        }
      ]
    }
  ]
}
