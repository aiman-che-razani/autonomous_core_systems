# After copying, run `python scripts/configure.py`: it replaces CHANGE_ME and fills
# every empty secret below with a random value. Compose refuses empty secrets.
# POSTGRES_PASSWORD is embedded in URLs: keep to A-Z a-z 0-9 _ - (configure.py does).
DATABASE_URL=postgresql+psycopg://greyqueue:CHANGE_ME@127.0.0.1:55441/greyqueue
POSTGRES_PASSWORD=
# Compose only: password of the least-privilege runtime role greyqueue_app
# (16+ characters from A-Z a-z 0-9 _ -; db-roles refuses anything else).
APP_DB_PASSWORD=
# Generate real values with `python scripts/configure.py`; empty placeholders are
# rejected (tokens need 16+ characters), so a copied example cannot start with known tokens.
CLIENT_TOKEN=
WORKER_TOKEN=
COORDINATOR_URL=http://127.0.0.1:8810
POLL_INTERVAL=0.2
CAPACITY=2
EXECUTOR=subprocess
SCHEDULER=priority
HEARTBEAT_INTERVAL=2
SUSPECT_AFTER=6
DEAD_AFTER=12
LEASE_SECONDS=10
MAINTENANCE_INTERVAL=0.5
QUEUE_LIMIT=10000
SUBMISSIONS_PER_MINUTE=20000
REQUIRE_TLS=false
# Host headers the coordinator answers (JSON list); add your proxy's hostname if remote.
ALLOWED_HOSTS=["127.0.0.1","localhost","coordinator"]
# Leave WORKER_ID unset so each process gets a fresh ID. A fixed ID can only re-register
# after the previous process with that ID has been marked DEAD.
# WORKER_ID=
